table Medidas
	lineageTag: 1570be87-50e5-4e65-875e-5243fadf2a1e

	measure 'Ticket Medio' = SUM(Pagamentos[payment_value]) / COUNT(Pedidos[order_id])
		formatString: 0
		lineageTag: 66fa7e90-bc0a-4ff8-b597-9db0fe049137

	measure TotalPedidos = COUNT(Pedidos[order_id])
		formatString: 0
		lineageTag: e73bb197-6cb3-4cba-b764-b6b20b415876

	measure '% Entrega no Prazo' = ```
			VAR PedidosComEntrega = FILTER(Pedidos, NOT ISBLANK(Pedidos[order_delivered_customer_date])) RETURN DIVIDE(CALCULATE(SUM(Pedidos[order_delivered_in_time]), PedidosComEntrega), CALCULATE(COUNTROWS(Pedidos), PedidosComEntrega)) 
			```
		lineageTag: b3489486-6abb-4a80-b7fb-5f424fccf152

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Media Entrega' = CALCULATE(AVERAGE(Pedidos[order_delivered_by_days]), NOT ISBLANK(Pedidos[order_delivered_customer_date]))
		lineageTag: 540be11e-b11e-40e6-97ab-825cffe572ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pedidos por Parcela' = COUNTROWS(PedidosParcelas)
		formatString: 0
		lineageTag: aed09090-1dcf-4d84-83f9-ff27164f1844

	measure 'Ticket Medio por Parcela' = AVERAGEX(PedidosParcelas, CALCULATE(SUM(Pagamentos[payment_value])))
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: 57d89cef-5eb5-4784-a97a-c8437fef6ac0

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	partition Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

